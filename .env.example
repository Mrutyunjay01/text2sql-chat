# Copy to .env and fill in. Never commit .env.

# --- LLM (OpenAI, Responses API) ---
OPENAI_API_KEY=
# Decision model: in scope? read-only? rewrites follow-ups as standalone questions
GATE_MODEL=gpt-6-luna
# SQL generation agent
PLANNER_MODEL=gpt-6.1-sol
# Turns result rows into the natural-language answer
ANSWER_MODEL=gpt-6-luna
# Reasoning effort per step: none (luna only) | low | medium | high | xhigh | max
GATE_EFFORT=low
PLANNER_EFFORT=medium
ANSWER_EFFORT=low
# Include the executed SQL in evidence (reveals table/column names)
EXPOSE_SQL=false

# --- Postgres superuser (used only by the db container for init) ---
POSTGRES_USER=chinook
POSTGRES_PASSWORD=change-me

# --- Read-only role used by the api ---
CHINOOK_RO_USER=chinook_ro
CHINOOK_RO_PASSWORD=change-me-too
